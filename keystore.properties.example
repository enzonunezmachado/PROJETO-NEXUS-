# Exemplo de configuracao de assinatura para atualizacoes sem desinstalacao.
# Copie este arquivo para "keystore.properties" na raiz do projeto (nunca faca commit de keystore.properties).
# Todos os campos podem alternativamente ser fornecidos por variaveis de ambiente no CI ou terminal.

# --- Assinatura de Release (recomendada para uso cotidiano estavel) ---
# storeFile=/caminho/seguro/nexus-release.jks
# storePassword=SENHA_FORTE_DA_KEYSTORE
# keyAlias=nexus_release
# keyPassword=SENHA_FORTE_DA_CHAVE

# --- Assinatura de Debug persistente (opcional, para unificar debug local e GitHub Actions) ---
# debugStoreFile=/caminho/seguro/nexus-debug-shared.keystore
# debugStorePassword=android
# debugKeyAlias=androiddebugkey
# debugKeyPassword=android
